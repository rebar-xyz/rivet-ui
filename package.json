{
  "name": "@rebarxyz/rivet-ui",
  "version": "0.1.3",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "description": "Lightweight React wallet hooks and UI for Cosmos chains",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebar-xyz/rivet-ui.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "default": "./dist/modal/index.js"
    },
    "./modal/styles.css": "./dist/modal/styles.css"
  },
  "scripts": {
    "build": "bun run clean && bun run build:main && bun run build:modal && bun run build:assets && bun run build:declarations",
    "build:main": "bun build src/index.ts --outdir=dist --entry-naming=[name].[ext] --target=browser --packages=external --production",
    "build:modal": "bun build src/modal/index.ts --outdir=dist/modal --entry-naming=[name].[ext] --target=browser --packages=external --production",
    "build:assets": "cp src/modal/styles.css dist/modal/styles.css",
    "build:declarations": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@rebarxyz/rivet": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
